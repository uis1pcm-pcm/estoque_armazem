rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isEmployee() { return signedIn() && request.auth.token.role == 'employee'; }

    match /items/{itemId} {
      allow read: if signedIn() && (isAdmin() || resource.data.active == true);
      allow write: if false;
    }
    match /employees/{employeeId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /employeeLookup/{matricula} { allow read, write: if false; }
    match /itemCodes/{code} { allow read, write: if false; }
    match /stockMovements/{movementId} {
      allow read: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.token.employeeId);
      allow write: if false;
    }
    match /locations/{locationId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /machineAssets/{assetId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /authLimits/{limitId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}